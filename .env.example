# OpenRouter API key for the "Ask me anything" chat box.
# Free: create a key at https://openrouter.ai/keys (no billing card needed for
# the ":free" models). Add it here (local) or in Vercel → Project → Settings →
# Environment Variables (production).
OPENROUTER_API_KEY=

# Optional: override the public GitHub username used by the GitHub Activity section.
# Defaults to the value in data/profile.ts if unset.
# NEXT_PUBLIC_GITHUB_USERNAME=NitinMohan03
