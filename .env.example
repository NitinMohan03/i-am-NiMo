# Anthropic API key for the "Ask me anything" chat box.
# Get one at https://console.anthropic.com/ then add it here (local) or in
# Vercel → Project → Settings → Environment Variables (production).
ANTHROPIC_API_KEY=

# Optional: override the public GitHub username used by the GitHub Activity section.
# Defaults to the value in data/profile.ts if unset.
# NEXT_PUBLIC_GITHUB_USERNAME=NitinMohan03
